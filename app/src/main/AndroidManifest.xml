<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:label="RentEase"
        android:supportsRtl="true"
        android:theme="@style/Theme.RentEase">
        <activity android:name=".ui.DatabaseViewerActivity" android:exported="true" />
        <activity android:name=".ui.MessagesActivity" android:exported="true" />
        <activity android:name=".ui.DrawerActivity" android:exported="true" />
        <activity android:name=".ui.ProfileActivity" android:exported="true" />
        <activity android:name=".ui.BookingActivity" android:exported="true" />
        <activity android:name=".ui.MyBookingsActivity" android:exported="true" />
        <activity android:name=".ui.AddPropertyActivity" android:exported="true" />
        <activity android:name=".ui.PropertyDetailsActivity" android:exported="true" />
        <activity android:name=".ui.PropertyListActivity" android:exported="true" />
        <activity android:name=".ui.HomeActivity" android:exported="true" />
        <activity android:name=".ui.LoginActivity" android:exported="true" />
        <activity android:name=".ui.SplashActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
