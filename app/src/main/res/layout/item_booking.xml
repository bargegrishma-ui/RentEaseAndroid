<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="7dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Reservation ID & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBookingId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 RESERVATION #BK-101"
                android:textColor="@color/green_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBookingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_active"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🟢 Confirmed"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="@color/border_gray" />

        <!-- Property Thumbnail & Details Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rounded Property Photo Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="94dp"
                android:layout_height="94dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivBookingProperty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/prop_real_bedroom" />
            </androidx.cardview.widget.CardView>

            <!-- Details Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBookingPropertyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="2 BHK Apartment - Andheri West"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Move-in Date -->
                <TextView
                    android:id="@+id/tvBookingMoveInDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="🗓️ Move-in: 15 Oct 2026"
                    android:textColor="@color/green_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Tenant Contact Info -->
                <TextView
                    android:id="@+id/tvBookingTenant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="👤 Rohit Sharma • 📞 9876543210"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <!-- Payment Status Pill Badge -->
                <TextView
                    android:id="@+id/tvBookingPayment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_pill_outline"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="💳 Paid: ₹2,000 Token via UPI"
                    android:textColor="@color/green_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Optional User Note Box (Hidden when redundant) -->
        <LinearLayout
            android:id="@+id/layoutMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvBookingMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💬 Tenant note"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Action Buttons Row: Cancel & View Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelBooking"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_outline"
                app:backgroundTint="@null"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:text="Cancel Booking"
                android:textAllCaps="false"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnViewProperty"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_green"
                app:backgroundTint="@null"
                android:minHeight="0dp"
                android:paddingHorizontal="14dp"
                android:text="View Property"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
